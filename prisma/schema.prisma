// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  displayOrder Int      @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String
  price        Float
  mrp          Float
  stock        Int            @default(0)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  orderItems   OrderItem[]
  isFeatured   Boolean        @default(false)
  isNewArrival Boolean        @default(false)
  isSale       Boolean        @default(false)
  material     String?
  occasion     String?
  careInstructions String?
  shippingInfo String?
  tags         String?        // comma-separated tags
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String  // e.g. "Color", "Size", "Set Type"
  value     String  // e.g. "Red", "Small", "Bhaiya-Bhabhi"
  stock     Int     @default(0)
  priceAdj  Float   @default(0) // price adjustment from base
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  state         String
  pincode       String
  items         OrderItem[]
  subtotal      Float
  shippingFee   Float       @default(0)
  total         Float
  paymentMethod String      // "cod" | "razorpay"
  paymentStatus String      @default("pending") // "pending" | "paid" | "failed"
  status        String      @default("placed")  // "placed" | "confirmed" | "shipped" | "delivered" | "cancelled"
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  shiprocketOrderId   Int?
  shiprocketShipmentId Int?
  awbCode             String?
  courierName         String?
  trackingUrl         String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int
  variant   String?
  imageUrl  String?
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerName String
  rating     Int      // 1-5
  comment    String
  imageUrl   String?
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
}
